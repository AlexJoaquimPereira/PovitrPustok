<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required by the liturgical Daily Reading feature (Retrofit/HTTPS). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        F2-07: predictive back. The flag opts the activity into the platform
        OnBackInvokedDispatcher, so Back is dispatched through the modern API
        and the system can animate it. Navigation Compose owns every in-app
        back path (its NavHost callback pops the stack); the app registers no
        BackHandler or OnBackPressedCallback of its own, so nothing suppresses
        the system animation. Attribute is ignored below API 33.
    -->
    <application
        android:name=".BibleApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PovitrPustok">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            F2-13: per-app language on API 30-32. `localeConfig` above only
            drives the system picker on API 33+; on older releases the
            AppCompat delegate stores the requested locale itself. The service
            is the documented opt-in marker for that storage, so a locale
            chosen before the later Settings picker exists survives process
            death. It stays disabled and unexported; it is metadata only.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
