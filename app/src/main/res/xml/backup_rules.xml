<?xml version="1.0" encoding="utf-8"?>
<!--
  BACKUP-01: explicit backup policy (API < 31).

  Whitelist only the application database (bookmarks, reading state, and the
  small reproducible liturgical cache). This is a whitelist: everything else,
  including the prepared Bible copies under files/bible (regenerated from the
  packaged assets on first open), is excluded automatically.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
</full-backup-content>
