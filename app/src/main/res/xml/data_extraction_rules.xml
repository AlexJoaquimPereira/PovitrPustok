<?xml version="1.0" encoding="utf-8"?>
<!--
  BACKUP-01: explicit backup policy (API 31+).

  Back up only the application database (bookmarks, reading state, liturgical
  cache) for both cloud backup and device transfer. The whitelist excludes
  everything else, including the prepared Bible copies under files/bible
  (derived from packaged assets and regenerated on first open).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
